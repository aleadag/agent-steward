{
  "name": "agent-steward",
  "version": "0.1.0-alpha.6",
  "private": true,
  "type": "module",
  "bin": {
    "agent-steward": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "skills/agent-steward/SKILL.md"
  ],
  "scripts": {
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun run build && bun test tests/*.test.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.18.6",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "5.9.3"
  }
}
